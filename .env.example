# ---------------------------------------------------------
# SIPCA - Variables de entorno
# Copia este archivo a .env y completa los valores.
# ---------------------------------------------------------

# --- LLM LOCAL (por defecto, NO consume APIs en la nube) ---
# Servidor compatible con OpenAI: LM Studio o Ollama.
#  - Ejecución local directa (streamlit run app.py): usa 127.0.0.1
#  - Dentro de Docker: usa host.docker.internal (ya configurado en docker-compose)
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=mistral-7b-instruct-v0.1
LOCAL_LLM_API_KEY=lm-studio

# Modelo para el análisis de imágenes (turbidez). DEBE soportar visión
# (multimodal): llava, qwen2-vl, moondream, etc. mistral-7b es solo-texto.
LOCAL_VISION_MODEL=mistral-7b-instruct-v0.1

# --- TELEGRAM (para alertas) ---
TELEGRAM_TOKEN=tu_token_de_telegram_aqui
TELEGRAM_BOT_NAME=tu_bot_aqui  # sin @ (opcional, ej. MiBotAgua_bot)

# --- PROVEEDORES EN LA NUBE (opcionales, solo si los eliges en la UI) ---
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
